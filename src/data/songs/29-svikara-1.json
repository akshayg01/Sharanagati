  "metaDescription": "Svīkara Song One (tuwā-bhakti-anukūla) of Śaraṇāgati (‘Surrender’) written by Bhaktivinoda Ṭhākura in 1893. This songbook contains 50 songs detailing the six symptoms of surrender unto the lotus feet of Śrī Kṛṣṇa.",
  "verseCount": 9,
  "verses": [
    {
      "label": "1",
      "translit": [
        "tuwā-bhakti-anukūla je-je kārya hoy",
        "parama-jatane tāhā koribo niścoy"
      ],
      "translation": "I will surely execute with utmost care those activities favorable to Your pure devotional service.",
      "deva": [
        "तुवा-भक्ति-अनुकूल जे-जे कार्य होय्",
        "परम-जतने ताहा कोरिबो निश्चोय्"
      ],
      "bengali": [
        "তুবা-ভক্তি-অনুকূল জে-জে কার্য হোয্",
        "পরম-জতনে তাহা কোরিবো নিশ্চোয্"
      ]
    },
    {
      "label": "2",
      "translit": [
        "bhakti-anukūla jata viṣaya saṁsāre",
        "koribo tāhāte rati indriyera dwāre"
      ],
      "translation": "I will feel fondness for those things in this world which are conducive to pure devotion, and with my senses I will engage them in Your service.",
      "deva": [
        "भक्ति-अनुकूल जत विषय संसारे",
        "कोरिबो ताहाते रति इन्द्रियेर द्वारे"
      ],
      "bengali": [
        "ভক্তি-অনুকূল জত বিষয সংসারে",
        "কোরিবো তাহাতে রতি ইন্দ্রিযের দ্বারে"
      ]
    },
    {
      "label": "3",
      "translit": [
        "śunibo tomāra kathā jatana koriyā",
        "dekhibo tomāra dhāma nayana bhoriyā"
      ],
      "translation": "I will carefully listen to all discussions concerning You, and the satisfaction of my eyes will be to behold Your divine abode.",
      "deva": [
        "शुनिबो तोमार कथा जतन कोरिया",
        "देखिबो तोमार धाम नयन भोरिया"
      ],
      "bengali": [
        "শুনিবো তোমার কথা জতন কোরিযা",
        "দেখিবো তোমার ধাম নযন ভোরিযা"
      ]
    },
    {
      "label": "4",
      "translit": [
        "tomāra prasāde deho koribo poṣan",
        "naivedya-tulasī-ghrāna koribo grahan"
      ],
      "translation": "I will nourish my body with the sacred remnants of Your food, and I will smell the sweet scent of tulasī leaves adorning those offerings.",
      "deva": [
        "तोमार प्रसादे देहो कोरिबो पोषन्",
        "नैवेद्य-तुलसी-घ्रान कोरिबो ग्रहन्"
      ],
      "bengali": [
        "তোমার প্রসাদে দেহো কোরিবো পোষন্",
        "নৈবেদ্য-তুলসী-ঘ্রান কোরিবো গ্রহন্"
      ]
    },
    {
      "label": "5",
      "translit": [
        "kara-dwāre koribo tomāra sevā sadā",
        "tomāra vasati-sthale basibo sarvadā"
      ],
      "translation": "With my hands I will always execute Your service, and I will forever dwell at that place where You abide.",
      "deva": [
        "कर-द्वारे कोरिबो तोमार सेवा सदा",
        "तोमार वसति-स्थले बसिबो सर्वदा"
      ],
      "bengali": [
        "কর-দ্বারে কোরিবো তোমার সেবা সদা",
        "তোমার বসতি-স্থলে বসিবো সর্বদা"
      ]
    },
    {
      "label": "6",
      "translit": [
        "tomāra sevāya kāma niyoga koribo",
        "tomāra vidveṣi-jane krodha dekhāibo"
      ],
      "translation": "I will employ my desires in Your devotional service, and will show my anger to those who are envious of You.",
      "deva": [
        "तोमार सेवाय काम नियोग कोरिबो",
        "तोमार विद्वेषि-जने क्रोध देखाइबो"
      ],
      "bengali": [
        "তোমার সেবায কাম নিযোগ কোরিবো",
        "তোমার বিদ্বেষি-জনে ক্রোধ দেখাইবো"
      ]
    },
    {
      "label": "7",
      "translit": [
        "ei-rūpe sarva-vṛtti āra sarva-bhāva",
        "tuwā anukūla hoye labhuka prabhāva"
      ],
      "translation": "In this way, may all of my propensities and emotions earn spiritual potency by being favorably dovetailed in Your interest.",
      "deva": [
        "एइ-रूपे सर्व-वृत्ति आर सर्व-भाव",
        "तुवा अनुकूल होये लभुक प्रभाव"
      ],
      "bengali": [
        "এই-রূপে সর্ব-বৃত্তি আর সর্ব-ভাব",
        "তুবা অনুকূল হোযে লভুক প্রভাব"
      ]
    },
    {
      "label": "8",
      "translit": [
        "tuwā bhakta-anukūla jāhā jāhā kori",
        "tuwā bhakti-anukūla boli’ tāhā dhori"
      ],
      "translation": "Anything I do which gives pleasure to Your devotee I will embrace as conducive to Your devotional service.",
      "deva": [
        "तुवा भक्त-अनुकूल जाहा जाहा कोरि",
        "तुवा भक्ति-अनुकूल बोलि’ ताहा धोरि"
      ],
      "bengali": [
        "তুবা ভক্ত-অনুকূল জাহা জাহা কোরি",
        "তুবা ভক্তি-অনুকূল বোলি’ তাহা ধোরি"
      ]
    },
    {
      "label": "9",
      "translit": [
        "bhakativinoda nāhi jāne dharmādharma",
        "bhakti-anukūla tāra hau saba karma"
      ],
      "translation": "Bhaktivinoda knows neither religion nor irreligion. He simply prays that all his activities be favorable for pure devotion unto You.",
      "deva": [
        "भकतिविनोद नाहि जाने धर्माधर्म",
        "भक्ति-अनुकूल तार हौ सब कर्म"
      ],
      "bengali": [
        "ভকতিবিনোদ নাহি জানে ধর্মাধর্ম",
        "ভক্তি-অনুকূল তার হৌ সব কর্ম"
      ]
    }
  ],
